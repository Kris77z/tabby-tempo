{
  "name": "agentfuel",
  "private": true,
  "workspaces": [
    "services/underwriter",
    "services/provider-relay",
    "services/arena",
    "packages/sdk",
    "packages/pi-loop",
    "packages/erc8004",
    "services/hosted-agents",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:all",
    "test:core": "npm test --workspace @agentfuel/underwriter && npm test --workspace @agentfuel/provider-relay",
    "test:all": "npm run test:core && npm test --workspace @agentfuel/arena && npm test --workspace @agentfuel/pi-loop && npm test --workspace @agentfuel/erc8004 && npm test --workspace @agentfuel/frontend && npm run test:hosted",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspace @agentfuel/frontend",
    "test:fork": "npm run test:fork --workspace @agentfuel/erc8004",
    "underwriter": "npm start --workspace @agentfuel/underwriter",
    "relay": "npm start --workspace @agentfuel/provider-relay",
    "predemo": "forge build --root contracts --skip-lint",
    "demo": "tsx scripts/demo.ts",
    "pretest:demo": "forge build --root contracts --skip-lint",
    "test:demo": "tsx --test scripts/test/demo.test.ts",
    "test:demo:monad": "tsx --test scripts/test/monad.test.ts",
    "backend": "tsx scripts/backend.ts",
    "task-runner": "tsx scripts/task-runner.ts",
    "relay:fixed": "tsx scripts/fixed-relay.ts",
    "test:backend": "npm run test:core && npm test --workspace @agentfuel/arena && npm test --workspace @agentfuel/pi-loop && npm test --workspace @agentfuel/erc8004 && npm run test:hosted",
    "test:backend:integration": "tsx --test --test-concurrency=1 scripts/test/*.test.ts",
    "hosted-agents": "tsx scripts/hosted-agents.ts",
    "test:hosted": "npm test --workspace @agentfuel/hosted-agents",
    "docs:check": "node scripts/check-doc-links.mjs",
    "test:sdk:standalone": "node scripts/check-sdk-standalone.mjs",
    "review:check": "node scripts/review-check.mjs",
    "economics:local": "node scripts/check-economic-loop.mjs",
    "test:publisher-worker": "node scripts/check-publisher-worker.mjs",
    "review:integration": "npm run economics:local && npm run test:publisher-worker && npm run economics:bounded -- --execute-local && npm run economics:independent && npm run economics:independent -- --execute-local",
    "strategy:demo": "tsx scripts/strategy-advice-demo.ts",
    "test:strategy-demo": "tsx --test scripts/test/strategy-advice-demo.test.ts",
    "operating:demo": "tsx scripts/operating-report-demo.ts",
    "operating:report": "tsx scripts/operating-report.ts",
    "test:operating-demo": "tsx --test scripts/test/operating-report-demo.test.ts",
    "review:evidence": "node scripts/review-evidence.mjs",
    "review:replay": "node scripts/review-replay.mjs",
    "economics:bounded": "node scripts/check-bounded-economy.mjs",
    "economics:independent": "node scripts/check-independent-economy.mjs",
    "review:artifacts": "node scripts/review-artifacts.mjs",
    "test:worker:guards": "node --import tsx --test examples/publisher-worker/test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "https-proxy-agent": "^7.0.6",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
