# chain (default) never substitutes local sample balances for missing network data.
FRONTEND_MODE=chain
# Absolute path, or relative to frontend/; see deployment.example.json.
FRONTEND_MANIFEST_PATH=
# Server-only explicit RPC transport. Requires the configured macOS HTTPS proxy when enabled.
FRONTEND_RPC_TRANSPORT=direct
# Optional server-only fixed demo private/state.json path; only verified SpendRejected fields are returned.
FRONTEND_DEMO_STATE_PATH=
# FRONTEND_RPC_TRANSPORT=system-https-proxy
# Explicit local visual demo, no RPC, no wallet broadcasts:
# FRONTEND_MODE=fixture

# Server-only loopback workflow service; browser always calls /api/tasks/runs.
# Leave unset to expose a disabled state without model calls.
# TASK_RUNNER_URL=http://127.0.0.1:8790

# Server-only hosted Agent service; signed login becomes an HttpOnly session cookie.
# HOSTED_AGENTS_URL=http://127.0.0.1:8791
# Must match hosted service origin exactly. Use HTTPS for a deployed front end.
# HOSTED_FRONTEND_ORIGIN=http://127.0.0.1:3020
# For a same-host TLS reverse proxy, keep Next bound to 127.0.0.1 and set:
# HOSTED_FRONTEND_ORIGIN=https://tempo.tabbyai.xyz
# HOSTED_FRONTEND_TRUST_PROXY=1
# The proxy must overwrite Host/X-Forwarded-Host with tempo.tabbyai.xyz and
# X-Forwarded-Proto with https. This flag does not enable remote upstreams.

# Persistent private freeplay state, outside the public/ directory.
# ARENA_PLAY_STATE_PATH=/srv/agentfuel-tempo/runtime/arena-freeplay.json

# Server-only, controlled read RPC pacing and transport. Use these for Tempo public RPC reads.
# AGENTFUEL_RPC_INTERVAL_MS=100
# AGENTFUEL_RPC_CALL_GAS_LIMIT=1000000
# AGENTFUEL_RPC_RETRY_READ_503=1
