# Fill deployed Account/provider before starting; this example cannot run unchanged.
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
ACCOUNT_ADDRESS=
PROVIDER_ADDRESS=
SETTLEMENT_ASSET=0x534b2f3A21130d7a60830c2Df862319e593943A3
ASSET_DECIMALS=6
SERVICE_ID=infercredit/coder
LOGICAL_MODEL=coder
PRICE=120000
QUOTE_TTL=300
CONFIRMATIONS=1
UPSTREAM_TIMEOUT_MS=60000
# Ordered physical upstreams. Base URL/model/key region must match your account.
UPSTREAMS_JSON='[{"name":"kimi","baseUrl":"https://api.moonshot.cn/v1","model":"kimi-k3","keyEnv":"KIMI_API_KEY"},{"name":"qwen","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-plus","keyEnv":"QWEN_API_KEY"}]'
KIMI_API_KEY=
QWEN_API_KEY=
HOST=127.0.0.1
PORT=8788
DATA_DIR=relay-data
# Optional exact browser origin; unset rejects cross-origin requests.
# FRONTEND_ORIGIN=http://localhost:3000
# Refunds stay disabled until both operator token and correct, funded refunder are configured.
OPERATOR_TOKEN=
REFUNDER_PRIVATE_KEY=
# Local CLI target; never point the operator CLI at a public host.
RELAY_URL=http://127.0.0.1:8788
