# Public testnet configuration. Copy deliberately and fill required roles/key.
# CHAIN_ID is informational; Deploy selects registries using block.chainid.
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
SETTLEMENT_ASSET=0x534b2f3A21130d7a60830c2Df862319e593943A3
# USDC has 6 decimals: 50 USDC / 20 USDC, expressed as raw smallest units.
MAX_TOTAL_OUTSTANDING=50000000
MAX_DRAW_PER_EPOCH=20000000
MAX_LTV_BPS=8000
PROTOCOL_FEE_BPS=0
GRACE=3600

# Required. Fill every value below before running any deployment command.
# Use distinct operational roles; never commit actual keys.
PRIVATE_KEY=
UNDERWRITER=
VERIFIER=
RELAY_REFUNDER=
# Optional: defaults are deployer / deployer / treasury respectively.
# TREASURY=
# GUARDIAN=
# FEE_RECIPIENT=
